# Configuración de red y puerto
PORT=3001
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:4200,http://localhost:8080

# Conexión local a MongoDB (sin credenciales)
MONGODB_URI=mongodb://127.0.0.1:27017/clinica-dentalDB

# Seguridad y Autenticación Keycloak / JWT (Pilar Seguridad)
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=dental-platform
# KEYCLOAK_PUBLIC_KEY=MIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQE...
# JWT_SECRET=super_secret_for_dev_or_testing
ODONTOLOGO_AUTH_ADAPTER=keycloak

# Integración MS1
PACIENTE_VALIDATOR_ADAPTER=mock
CATALOGO_SERVICIOS_ADAPTER=mock
MS1_GRAPHQL_URL=http://127.0.0.1:8081/graphql
MS1_TIMEOUT_MS=2000

# RabbitMQ & Outbox Relay
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_EXCHANGE=dental.topic.exchange
RABBITMQ_ROUTING_KEY=clinica.consulta.finalizada
RABBITMQ_PUBLISHER_ADAPTER=mock
OUTBOX_RELAY_ENABLED=false
OUTBOX_POLL_INTERVAL_MS=3000
OUTBOX_BATCH_SIZE=10
OUTBOX_MAX_ATTEMPTS=5
